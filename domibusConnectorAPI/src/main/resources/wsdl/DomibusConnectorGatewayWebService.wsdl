<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions
        xmlns:tns="http://connector.ecodex.eu/ws/gateway/webservice"
        xmlns:dct="transition.domain.connector.ecodex.eu"
        xmlns:wp="http://connector.ecodex.eu/ws/gateway/webservice"
        xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        name="DomibusConnectorGatewayWebService"
        targetNamespace="http://connector.ecodex.eu/ws/gateway/webservice">

    <wsdl:import
            namespace="transition.domain.connector.ecodex.eu"
            location="eu.ecodex.connector.domain.transition/DomibusConnectorTransitionModel.xsd"/>

    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                targetNamespace="http://connector.ecodex.eu/ws/gateway/webservice">
            <xsd:complexType name="ListPendingMessageIdsRequest">
                <!-- empty type -->
            </xsd:complexType>
            <xsd:complexType name="ListPendingMessageIdsResponse">
                <xsd:sequence>
                    <xsd:element name="messageIds" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="GetMessageByIdRequest">
                <xsd:sequence>
                    <xsd:element name="messageId" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="submitMessageRequest">
        <wsdl:documentation>
            Request object containing a business message to submit to the gateway.
        </wsdl:documentation>
        <wsdl:part name="submitMessageRequest" type="dct:DomibusConnectorMessageType"/>
    </wsdl:message>
    <wsdl:message name="submitMessageResponse">
        <wsdl:documentation>
            Response object containing an acknowledgement message for the connector.
        </wsdl:documentation>
        <wsdl:part name="submitMessageResponse" type="dct:DomibsConnectorAcknowledgementType"/>
    </wsdl:message>
    <wsdl:message name="listPendingMessageIdsRequest">
        <wsdl:documentation>Request object containing literally nothing</wsdl:documentation>
        <wsdl:part name="listPendingMessageIdsRequest" type="wp:ListPendingMessageIdsRequest"/>
    </wsdl:message>
    <wsdl:message name="listPendingMessageIdsResponse">
        <wsdl:documentation>
            Response object containing a list of the business message transport ids pending for
            the requesting connector at the gateway.
        </wsdl:documentation>
        <wsdl:part name="listPendingMessageIdsResponse" type="wp:ListPendingMessageIdsResponse"/>
    </wsdl:message>
    <wsdl:message name="getMessageByIdRequest">
        <wsdl:documentation>
            Request object containing a business message transport ID.
        </wsdl:documentation>
        <wsdl:part name="getMessageByIdRequest" type="wp:GetMessageByIdRequest"/>
    </wsdl:message>
    <wsdl:message name="getMessageByIdResponse">
        <wsdl:documentation>
            Response object containing a business message
        </wsdl:documentation>
        <wsdl:part name="getMessageByIdResponse" type="dct:DomibusConnectorMessageType"/>
    </wsdl:message>

    <wsdl:portType name="DomibusConnectorGatewayWebService">
        <wsdl:operation name="submitMessage">
            <wsdl:documentation>Submit a business message to the gateway.</wsdl:documentation>
            <wsdl:input message="tns:submitMessageRequest"/>
            <wsdl:output message="tns:submitMessageResponse"/>
        </wsdl:operation>
        <wsdl:operation name="listPendingMessageIds">
            <wsdl:documentation>
                Return the connector internal business message transport IDs of messages pending at
                the gateway.
            </wsdl:documentation>
            <wsdl:input message="tns:listPendingMessageIdsRequest"/>
            <wsdl:output message="tns:listPendingMessageIdsResponse"/>
        </wsdl:operation>
        <wsdl:operation name="getMessageById">
            <wsdl:documentation>
                Retrieve the connector internal business message from the gateway based on its
                transport ID.
            </wsdl:documentation>
            <wsdl:input message="tns:getMessageByIdRequest"/>
            <wsdl:output message="tns:getMessageByIdResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="DomibusConnectorGatewayWSBinding" type="tns:DomibusConnectorGatewayWebService">
        <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="submitMessage">
            <soap12:operation soapAction="" style="document"/>
            <wsdl:input>
                <soap12:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap12:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
        <wsdl:operation name="listPendingMessageIds">
            <soap12:operation soapAction="" style="document"/>
            <wsdl:input>
                <soap12:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap12:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
        <wsdl:operation name="getMessageById">
            <soap12:operation soapAction="" style="document"/>
            <wsdl:input>
                <soap12:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap12:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="DomibusConnectorGatewayWSService">
        <wsdl:documentation>
            This is the main entry point for the DomibusConnectorGatewayWebService SOAP API.
        </wsdl:documentation>
        <wsdl:port binding="tns:DomibusConnectorGatewayWSBinding" name="DomibusConnectorGatewayWebService">
            <soap12:backendPublishAddress location="http://connector.ecodex.eu/ws/gateway/webservice"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
